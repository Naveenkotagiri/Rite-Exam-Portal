# systemd service for the Rite Exam Portal. Install (see DEPLOY.md, Step 6):
#   sudo cp /opt/rite-exam-portal/deploy/rite-exam-portal.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now rite-exam-portal
[Unit]
Description=Rite Exam Portal
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=rite-exam
Group=rite-exam
WorkingDirectory=/opt/rite-exam-portal/backend
# Settings (database, secrets, PORT). systemd reads this file as root, so it can stay chmod 600.
EnvironmentFile=/opt/rite-exam-portal/deploy/.env
# Listen on this server only; nginx forwards the portal's domain to it.
Environment=APP_ENV=production HOST=127.0.0.1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rite-exam-portal/backend/.venv/bin/python -m app.server
Restart=always
RestartSec=5

# The portal writes nothing to disk (everything goes to PostgreSQL), so lock the process down.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
