# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Read by the systemd service (deploy/rite-exam-portal.service): plain KEY=value lines, no spaces around "=".

# Port the portal listens on, on 127.0.0.1 only; nginx forwards to it (must match deploy/nginx/rite-exam-portal.conf)
PORT=8085

# PostgreSQL. On this same server use 127.0.0.1 (never the server's own public IP; OCI blocks that route).
# Use a dedicated database and user, not the postgres superuser.
# Letters and digits in the password are safest (other characters must be URL-encoded).
DATABASE_URL=postgres://rite_exam:PASSWORD@127.0.0.1:5432/rite_exam
# Set to true if the database server requires SSL connections
DATABASE_SSL=false

# Signs admin logins (generate: openssl rand -hex 32)
JWT_SECRET=

# First admin, created on the first start. Change the password after logging in, then clear ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Worker processes: about one per vCPU (4 handled 500 students at once in testing)
WEB_CONCURRENCY=4
