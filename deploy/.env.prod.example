# Copy to deploy/.env on the server and fill in. Never commit the real file.

# The portal's address, e.g. exam.rite.digital (its DNS A record must point to this server's public IP)
DOMAIN=exam.example.com

# ---- Database: choose ONE ----
# A) Your own PostgreSQL server. Use a dedicated database and user, not the postgres superuser.
#    Letters and digits in the password are safest (other characters must be URL-encoded).
DATABASE_URL=postgres://rite_exam:PASSWORD@DB_HOST:5432/rite_exam
# Set to true if that server requires SSL connections
DATABASE_SSL=false
#
# B) A PostgreSQL container on this server: delete the DATABASE_URL line above, set DB_PASSWORD
#    (generate: openssl rand -hex 24) and start with:  --profile local-db
# DB_PASSWORD=

# Signs admin logins (generate: openssl rand -hex 32)
JWT_SECRET=

# First admin, created on the first start. Change the password after logging in, then clear ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Worker processes: about one per vCPU (4 handled 500 students at once in testing)
WEB_CONCURRENCY=4
