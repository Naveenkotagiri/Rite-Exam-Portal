# Rite Exam Portal – production settings. Copy to deploy/.env on the server (and ONLY there), fill in, chmod 600.
# Never commit the real file.
#
# Format rules (the file is read by systemd):
#   - KEY=value, no spaces around "=", one setting per line
#   - no quotes needed; no "# comments" after a value (they become part of the value)
#   - made on Windows? convert the line endings once:  sed -i 's/\r$//' deploy/.env
# Check everything with:  /opt/rite-exam-portal/deploy/preflight.sh

# Port the portal listens on, on 127.0.0.1 only; nginx forwards to it (must match proxy_pass in the nginx file)
PORT=8085

# PostgreSQL on this same server: always 127.0.0.1, never the server's own public IP (OCI blocks that route).
# The user must OWN the database (CREATE DATABASE rite_exam OWNER rite_exam;).
# Letters and digits in the password are safest (other characters must be URL-encoded, e.g. @ → %40).
DATABASE_URL=postgres://rite_exam:PASSWORD@127.0.0.1:5432/rite_exam
# true only if the database server requires SSL connections
DATABASE_SSL=false

# Signs admin logins (generate: openssl rand -hex 32). Do not change it after go-live.
JWT_SECRET=

# First admin, created on the first start. Change the password after logging in, then clear ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Worker processes: about one per vCPU (4 handled 100 simultaneous students with answers saved in ~10 ms)
WEB_CONCURRENCY=4
