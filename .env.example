# Local development settings. Copy to .env (the Python backend reads it from the project folder).
# For the production server, see deploy/.env.prod.example instead.

APP_ENV=development

# PostgreSQL (the Docker database from `npm run db:up`)
DATABASE_URL=postgres://exam:exam@localhost:5440/exam
DATABASE_SSL=false

# Signs admin logins. Use a long random value anywhere other than your own laptop.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on start-up when no admins exist yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@rite.digital
ADMIN_PASSWORD=ChangeMe@123

PORT=3000
