{
  "name": "rite-exam-portal",
  "version": "2.0.0",
  "private": true,
  "description": "Rite Exam Portal: React frontend + Python (FastAPI) backend + PostgreSQL.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:client": "vite",
    "setup:backend": "node scripts/setup-backend.mjs",
    "build": "vite build",
    "start": "node scripts/py.mjs -m app.server",
    "seed": "node scripts/py.mjs -m app.cli seed",
    "create-admin": "node scripts/py.mjs -m app.cli create-admin",
    "migrate": "node scripts/py.mjs -m app.cli migrate",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "node scripts/py.mjs -m pytest",
    "test:e2e": "playwright test",
    "lint": "node scripts/py.mjs -m ruff check app alembic tests"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.56.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.4"
  }
}
