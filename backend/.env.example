# Local development settings. Copy to backend/.env (the backend reads it from its own folder).
# For the production server, see deploy/.env.prod.example instead.

APP_ENV=development

# Local PostgreSQL (see "Develop" in backend/README.md)
DATABASE_URL=postgres://exam:exam@localhost:5432/exam
DATABASE_SSL=false

# Signs admin logins. Use a long random value anywhere other than your own laptop.
JWT_SECRET=change-me-to-a-long-random-string

# First admin account, created on start-up when no admins exist yet.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@rite.digital
ADMIN_PASSWORD=ChangeMe@123

PORT=3000
