# Rite Exam Portal backend – production settings. Copy to backend/.env, fill in, chmod 600. Never share it.
#
# Format rules (the file is read by systemd):
#   - KEY=value, no spaces around "=", one setting per line
#   - no quotes needed; no "# comments" after a value (they become part of the value)
#   - made on Windows? convert the line endings once:  sed -i 's/\r$//' .env

# Where the API listens. 172.17.0.1 is this server's Docker bridge address: the nginx container reaches it there,
# the internet does not. (nginx running directly on the server, not in Docker: HOST=127.0.0.1)
HOST=172.17.0.1
PORT=8085
# Trust the real visitor IP that nginx passes on, only from the Docker network (used for rate limits).
FORWARDED_ALLOW_IPS=172.17.0.0/16

# PostgreSQL. It runs on this server (container "postgres-service", published on port 5432): use 127.0.0.1,
# never the server's public IP (OCI blocks that route). The user must OWN the database.
# Letters and digits in the password are safest (other characters must be URL-encoded, e.g. @ → %40).
DATABASE_URL=postgres://rite_exam:PASSWORD@127.0.0.1:5432/rite_exam
DATABASE_SSL=false
# For backup.sh: the PostgreSQL container whose pg_dump to use
PG_CONTAINER=postgres-service

# Signs admin logins (generate: openssl rand -hex 32). Do not change it after go-live.
JWT_SECRET=

# First admin, created on the first start. Change the password after logging in, then clear ADMIN_PASSWORD.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Worker processes: about one per vCPU
WEB_CONCURRENCY=4
